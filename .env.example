# Mapbox GL JS access token. Get one at https://account.mapbox.com/access-tokens/
# Copy this file to .env and fill in your token, then run `npm run build`.
MAPBOX_TOKEN=

# InsForge — database persistence for agent monitor data
# Get these from your InsForge dashboard at insforge.dev
INSFORGE_URL=https://your-app.insforge.app
INSFORGE_SERVICE_KEY=your-service-key

# How often (ms) to flush buffered agent states to the DB (default 5000)
INSFORGE_FLUSH_MS=5000

# How many hours of snapshots to keep — older rows are deleted after each flush (default 24)
INSFORGE_RETAIN_HOURS=24
